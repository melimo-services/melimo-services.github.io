---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/url";
---

<BaseLayout title="Page introuvable">
  <section
    class="mx-auto flex max-w-2xl flex-col items-center gap-4 px-4 py-24 text-center sm:px-6"
  >
    <p class="font-display text-6xl font-semibold text-primary">404</p>
    <h1 class="font-display text-2xl font-semibold text-text">
      Cette page n'existe pas.
    </h1>
    <p class="text-text-muted">
      La page que vous cherchez a peut-être été déplacée ou n'existe plus.
    </p>
    <a
      href={withBase("")}
      class="mt-4 inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary-dark"
    >
      Retour à l'accueil
    </a>
  </section>
</BaseLayout>
