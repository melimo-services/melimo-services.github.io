---
import { Image } from "astro:assets";
import familleImage from "../assets/images/famille.jpg";
import { withBase } from "../utils/url";
---

<section class="border-b border-border bg-surface-alt">
  <div
    class="mx-auto grid max-w-5xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-24"
  >
    <div>
      <p class="text-sm font-semibold tracking-wide text-primary uppercase">
        Services à la personne
      </p>
      <h1
        class="mt-3 font-display text-4xl font-semibold text-text sm:text-5xl"
      >
        Le quotidien allégé, chez vous, en toute confiance.
      </h1>
      <p class="mt-5 max-w-prose text-lg text-text-muted">
        Ménage, garde d'enfants, jardinage, aide administrative, courses et
        bricolage : nos intervenants s'occupent de votre foyer à Valenciennes
        et en Dordogne, avec jusqu'à 50% de crédit d'impôt.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={withBase("contact/")}
          class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-dark"
        >
          Demander un devis gratuit
        </a>
        <a
          href="#services"
          class="inline-flex items-center justify-center rounded-full border border-border px-6 py-3 text-sm font-semibold text-text transition-colors hover:bg-surface"
        >
          Voir nos services
        </a>
      </div>
    </div>
    <Image
      src={familleImage}
      alt="Une famille sereine chez elle"
      width={640}
      height={480}
      class="w-full rounded-3xl object-cover shadow-md"
    />
  </div>
</section>
