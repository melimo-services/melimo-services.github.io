---
import type { InterventionZone } from "../data/contact";

interface Props {
  zone: InterventionZone;
}

const { zone } = Astro.props;
const phoneHref = `tel:${zone.phone.replace(/\s/g, "")}`;
---

<article
  class="flex flex-col gap-4 rounded-2xl border border-border bg-surface p-6 shadow-sm"
>
  <h3 class="flex items-start gap-2 font-display text-xl font-semibold text-text">
    <svg
      class="mt-0.5 h-5 w-5 shrink-0 text-primary"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M12 2v3M12 19v3M22 12h-3M5 12H2M19.07 4.93l-2.12 2.12M7.05 16.95l-2.12 2.12M19.07 19.07l-2.12-2.12M7.05 7.05 4.93 4.93"
      ></path>
    </svg>
    {zone.name}
  </h3>
  <a
    href={phoneHref}
    class="flex items-center gap-2 text-sm font-medium text-primary hover:text-primary-dark"
  >
    <svg
      class="h-5 w-5 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"
      ></path>
    </svg>
    {zone.phone}
  </a>
</article>
